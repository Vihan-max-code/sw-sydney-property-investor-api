const ML={intercept:497.4,c:{beds:68.6,baths:59.9,cars:11.8,is_unit:-42.8,is_townhouse:-50.4,"suburb_Glenfield":-155.8,"suburb_Holsworthy":-75.0,"suburb_Leumeah":-198.8,"suburb_Macquarie Fields":-153.4,"suburb_Minto":-156.2}};
const PR={"Macquarie Fields":{g:7.52},"Minto":{g:7.83},"Leumeah":{g:7.76},"Glenfield":{g:9.56},"Holsworthy":{g:2.00},"East Hills":{g:6.31}};
const INF={"Macquarie Fields":{a:0.06},"Minto":{a:0.00},"Leumeah":{a:0.04},"Glenfield":{a:0.21},"Holsworthy":{a:0.02},"East Hills":{a:0.11}};
function cap(s){return(s||"").split(" ").map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(" ")}
function predictRent(b,bt,c,pt,sub){const iu=/unit|apartment|studio/i.test(pt||"");const it=/townhouse|villa/i.test(pt||"");let r=ML.intercept;r+=(b||3)*ML.c.beds;r+=(bt||1)*ML.c.baths;r+=(c||1)*ML.c.cars;if(iu)r+=ML.c.is_unit;if(it)r+=ML.c.is_townhouse;const k="suburb_"+cap(sub);if(ML.c[k]!==undefined)r+=ML.c[k];return Math.round(Math.max(r,250))}
function predictPrice(b,bt,c,land,pt,sd){const iu=/unit|apartment|studio/i.test(pt||"");const it=/townhouse|villa/i.test(pt||"");let p=iu?(sd?.unit?.medianPrice||688000):(sd?.house?.medianPrice||1000000);p*=(1+((b||3)-3)*0.18);p*=(1+((bt||1)-1)*0.10);p*=(1+((c||1)-1)*0.03);if(!iu&&land&&land>0)p*=(1+(land-400)*0.0004);if(it&&!iu)p*=0.85;const inf=INF[cap(sd?.name||"")];if(inf)p*=(1+inf.a);return Math.round(p/5000)*5000}
function analyseProperty(price,beds,baths,landSize,pt,sd){if(!price||price<50000||price>10000000)return null;const iu=/unit|apartment|studio/i.test(pt||"");const dom=iu?(sd?.unit?.daysOnMarket||20):(sd?.house?.daysOnMarket||15);const median=iu?(sd?.unit?.medianPrice||688000):(sd?.house?.medianPrice||1000000);const vsMedian=((price-median)/median)*100;const sub=sd?.name||"Macquarie Fields";const rent=predictRent(beds,baths,1,pt,sub);const grossYield=(rent*52/price)*100;const proj=PR[cap(sub)];const growth=proj?proj.g:6.0;const proj5=Math.round(price*Math.pow(1+growth/100,5));const equity5=proj5-price;const modelPrice=predictPrice(beds,baths,1,landSize,pt,sd);let score=40;const reasons=[];if(grossYield>=5){score+=25;reasons.push("Excellent yield")}else if(grossYield>=4.5){score+=20;reasons.push("Strong yield")}else if(grossYield>=4){score+=16;reasons.push("Good yield")}else if(grossYield>=3.5){score+=12;reasons.push("Solid yield")}else if(grossYield>=3){score+=8;reasons.push("Average yield")}else if(grossYield>=2.5){score+=4;reasons.push("Below-avg yield")}if(vsMedian<-30){score+=15;reasons.push("Deep value")}else if(vsMedian<-15){score+=12;reasons.push("Well below median")}else if(vsMedian<-5){score+=8;reasons.push("Below median")}else if(vsMedian<5){score+=5;reasons.push("At median")}if(landSize>=700){score+=10;reasons.push("Large land")}else if(landSize>=500){score+=7;reasons.push("Good land")}else if(landSize>=300){score+=4}if(beds>=3&&beds<=4){score+=5;reasons.push("High-demand config")}else if(beds>=5){score+=3;reasons.push("Large home")}else if(beds===2){score+=3}if(baths>=2&&beds>=3)score+=3;score=Math.min(Math.max(score,10),98);const verdict=score>=80?"STRONG BUY":score>=65?"BUY":score>=50?"HOLD":"WEAK";const color=score>=80?"#10b981":score>=65?"#22c55e":score>=50?"#f59e0b":"#ef4444";return{score,verdict,color,reasons,grossYield:grossYield.toFixed(2),rent,dom,growth:growth.toFixed(2),proj5,equity5,modelPrice}}
module.exports={analyseProperty,predictRent,predictPrice};
